{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "Ergon node public cockpit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema_version",
    "project",
    "enums",
    "workstreams",
    "boundaries",
    "gates",
    "research_topics",
    "roadmap_generation"
  ],
  "properties": {
    "$comment": {"const": "SPDX-License-Identifier: MIT"},
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "baseline"],
      "properties": {
        "id": {"const": "ergon-lab"},
        "language": {"const": "en"},
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "version", "commit"],
          "properties": {
            "project": {"const": "Bitcoin Static"},
            "version": {"const": "24.0.5"},
            "commit": {"const": "2e8d5f7635c899cc99e71f06dedbe72b3ff7f07b"}
          }
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_state", "knowledge_status"],
      "properties": {
        "delivery_state": {
          "const": ["verified", "active", "blocked", "planned", "research"]
        },
        "knowledge_status": {
          "const": [
            "Explainer",
            "Hypothesis",
            "Simulation",
            "Observed",
            "Reproduced",
            "Open Question"
          ]
        }
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": {"enum": ["build-operate", "learn", "research", "observatory"]},
          "title": {"enum": ["Build / Operate", "Learn", "Research", "Observatory"]}
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consensus_authority",
        "chronik",
        "price_scope",
        "publication_policy"
      ],
      "properties": {
        "consensus_authority": {"const": "standalone-node"},
        "chronik": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "consensus_authority",
            "mempool_authority",
            "chain_selection_authority",
            "required_for_correctness"
          ],
          "properties": {
            "role": {"const": "observe-and-index-only"},
            "consensus_authority": {"const": false},
            "mempool_authority": {"const": false},
            "chain_selection_authority": {"const": false},
            "required_for_correctness": {"const": false}
          }
        },
        "price_scope": {"const": "historical-context-no-financial-forecasting"},
        "publication_policy": {"const": "clean-room-allowlist-only"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {"$ref": "entry.schema.json"},
          {"properties": {"kind": {"const": "gate"}}}
        ]
      }
    },
    "research_topics": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "allOf": [
          {"$ref": "entry.schema.json"},
          {"properties": {"kind": {"const": "research-topic"}}}
        ]
      }
    },
    "roadmap_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "event_log", "document", "manifest"],
      "properties": {
        "projection": {
          "const": [
            "boundaries",
            "gates.*.id",
            "gates.*.delivery_state",
            "gates.*.roadmap"
          ]
        },
        "event_log": {"const": "cockpit/events/roadmap-events.yaml"},
        "document": {"const": "docs/roadmap.md"},
        "manifest": {"const": "cockpit/generated/roadmap-manifest.json"}
      }
    }
  }
}
