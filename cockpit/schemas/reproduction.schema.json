{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: MIT",
  "title": "Public reproduction pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["availability", "blockers"],
  "properties": {
    "availability": {
      "enum": ["not-yet-published", "published"]
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_results": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies_locked", "platforms"],
      "properties": {
        "dependencies_locked": {"type": "boolean"},
        "lock_reference": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"dependencies_locked": {"const": true}},
            "required": ["dependencies_locked"]
          },
          "then": {"required": ["lock_reference"]}
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"availability": {"const": "published"}},
        "required": ["availability"]
      },
      "then": {
        "required": [
          "location",
          "sha256",
          "commands",
          "expected_results",
          "environment"
        ],
        "properties": {"blockers": {"maxItems": 0}}
      },
      "else": {
        "properties": {"blockers": {"minItems": 1}}
      }
    }
  ]
}
